DATABASE_URL_ASYNC=postgresql+asyncpg://fintrack:fintrack@localhost:5432/fintrack
DATABASE_URL_SYNC=postgresql+psycopg://fintrack:fintrack@localhost:5432/fintrack
REDIS_URL=redis://localhost:6379/0

# Pillar 1 (Price) — Alpha Vantage is keyless-free-tier signup; yfinance needs no key at all
ALPHA_VANTAGE_API_KEY=

# Pillar 4 (Research) — leave as "mock" until real credentials exist; see backend/app/clients/
REDDIT_CLIENT_IMPL=mock
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fintrack/0.1

# RESEARCH_AGENT_IMPL: "mock" (no LLM), "ollama" (local, free, needs `ollama serve` running),
# or "anthropic" (needs ANTHROPIC_API_KEY, billed per token)
RESEARCH_AGENT_IMPL=mock
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# Web Push (Checkpoint 6) — generate with: uv run python -m app.core.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@fintrack.local
